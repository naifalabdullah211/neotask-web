rules_version = '2';

// =============================================================================
// NeoTask — Firestore Security Rules
// =============================================================================
// Replaces the previous `allow read, write: if true;` (fully public,
// unauthenticated read/write to every document in the database).
//
// ARCHITECTURAL CONSTRAINT (see firestore_service.dart): most collections
// are read via UNFILTERED `.collection(x).snapshots()` listeners (no
// `.where()`), with role/ownership filtering done client-side in Dart
// memory. Per official Firestore docs, "rules are not filters — queries are
// all-or-nothing": a `list`/read rule that conditions on a per-document
// field (e.g. `resource.data.assignedTo == request.auth.uid`) would make
// these unfiltered queries FAIL ENTIRELY, not just narrow their results.
// Reference: https://firebase.google.com/docs/firestore/security/rules-query
//
// Therefore this ruleset uses:
//   READ:  `request.auth != null` (any signed-in account of THIS
//          deployment) for the collections that are read via unfiltered
//          listeners. This is the core fix for the reported vulnerability —
//          previously ANYONE on the public internet, with no account at
//          all, could read/write everything.
//   WRITE: strict, per-field, per-role validation — writes are always
//          single-document operations and are NOT subject to the
//          "queries are all-or-nothing" limitation above, so real
//          role-based/ownership enforcement IS applied here.
//
// RESIDUAL LIMITATION (flagged, not silently glossed over): this does NOT
// give employee-vs-employee read isolation (e.g. employee A can technically
// still read employee B's tasks/messages once signed in, because the
// client's unfiltered-listen architecture requires a uniform read gate).
// Closing that fully would require either (a) refactoring every screen to
// use `.where()`-scoped queries matching per-role rules, or (b) moving reads
// behind a Cloud Functions callable API. Out of scope for this pass.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // `get()` inside rules bypasses security rules for the read it performs
    // (this is documented, standard Firestore behavior) — safe to use here
    // even though a plain employee cannot otherwise read arbitrary fields
    // of another user's profile via a client query.
    function isManager() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // `designer` — read-only observer role (see UserRole.designer doc
    // comment in lib/models/user_model.dart for the full 1-a/2-a/3-no
    // design rationale). Used ONLY to explicitly DENY writes on
    // collections that were previously gated by `isSignedIn()` alone
    // (which a designer, being a signed-in account, would otherwise
    // satisfy). Collections already gated by `isManager()` or by
    // ownership fields a designer can never legitimately hold
    // (tasks/criteria/goals/users) need no additional check, since a
    // designer account can never be its own author/assignee there.
    function isDesigner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'designer';
    }

    // ---- system/manager_lock sentinel ----
    // Public-read is intentional: SplashRouter must decide "show
    // ManagerSetupScreen vs. LoginScreen" BEFORE anyone is signed in, and
    // this tiny sentinel doc (no PII, just createdAt/createdBy) is how that
    // decision is made without exposing the `users` collection itself.
    // Creation is guarded by BOTH this rule AND the atomic Firestore
    // transaction in `createManagerProfile()` (see firestore_service.dart)
    // that writes this doc in the SAME transaction as the manager's
    // `users/{uid}` doc — this is what makes the single-manager invariant
    // race-safe under concurrent bootstrap attempts.
    match /system/manager_lock {
      allow read: if true;
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/system/manager_lock) &&
        request.resource.data.createdBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
      allow update, delete: if false;
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();

      // Two creation paths, both keyed by the Firebase Auth uid of the
      // caller (i.e. you can only ever create YOUR OWN profile doc — the
      // Auth account itself was already created by the time this write
      // happens, per AuthProvider.ensureManagerExists/registerViaInvite):
      //
      //   1) Manager bootstrap. CRITICAL: it is NOT enough to check
      //      `!exists(manager_lock)` — that only proves the lock doesn't
      //      exist YET, it does NOT force the caller to actually create it.
      //      A client could create this users/{uid} doc with role=manager
      //      WITHOUT ever writing manager_lock, and repeat that indefinitely
      //      (every future check would still see !exists(manager_lock)),
      //      producing unlimited fraudulent managers. This was empirically
      //      verified against production during rules testing (2026-07-10)
      //      before this fix was added — see incident notes.
      //      FIX: use getAfter() to require that, within this SAME atomic
      //      transaction/batch, system/manager_lock is ALSO created and
      //      its createdBy field equals this uid. This matches exactly
      //      what FirestoreService.createManagerProfile()'s transaction
      //      does — so the legitimate app flow is unaffected, but any
      //      write that creates a manager-role user doc WITHOUT also
      //      atomically creating the lock (pointing at the same uid) is
      //      now rejected at the rules layer, not just by app discipline.
      //   2) Employee self-registration via invite — the invite-token
      //      validity itself is enforced by the `invitations` update rule
      //      below (same transaction, same request.auth).
      //      RESIDUAL LIMITATION (flagged, NOT fixed in this pass): unlike
      //      the manager path above, this branch does NOT cross-check via
      //      getAfter() that a real invitations/{id} doc was atomically
      //      transitioned to status=used/usedByUid=uid in the same write.
      //      The invitations query in consumeInviteAndRegister() looks up
      //      the invite doc by a `where('token', ...)` query, so its
      //      document ID is not known to this rule without a client-side
      //      data-model change (e.g. passing inviteId as a field). Impact
      //      is bounded: this only lets a signed-in user reach
      //      accountStatus='pendingApproval' without a real invite link —
      //      it does NOT grant elevated role or bypass manager approval —
      //      but it is a real, unaddressed gap in the "invite-only
      //      registration" design and must be explicitly acknowledged.
      allow create: if
        (isOwner(uid) &&
         request.resource.data.uid == uid &&
         (
          (request.resource.data.role == 'manager' &&
           request.resource.data.accountStatus == 'active' &&
           !exists(/databases/$(database)/documents/system/manager_lock) &&
           getAfter(/databases/$(database)/documents/system/manager_lock).data.createdBy == uid)
          ||
          (request.resource.data.role == 'employee' &&
           request.resource.data.accountStatus == 'pendingApproval')
         ))
        ||
        (isManager() &&
         request.resource.data.uid == uid &&
         request.resource.data.role == 'employee' &&
         request.resource.data.accountStatus == 'active' &&
         request.resource.data.approvedBy == request.auth.uid);

      // Two update paths:
      //   1) Manager updating ANOTHER user's doc — ONLY the
      //      approval-workflow fields (accountStatus/approvedBy/
      //      approvedAt). This specifically prevents any client from
      //      writing `role` after creation (blocks self-promotion to
      //      manager) and prevents a manager from silently rewriting
      //      someone else's email/name via this path.
      //   2) Self-service settings update — preferences and the account
      //      owner's Cloudinary-hosted profile photo only.
      allow update: if (isManager() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accountStatus', 'approvedBy', 'approvedAt', 'weeklyCapacityHours']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyCapacityHours']) ||
         (request.resource.data.weeklyCapacityHours is number &&
          request.resource.data.weeklyCapacityHours > 0 &&
          request.resource.data.weeklyCapacityHours <= 168))) ||
        // Any signed-in user may update ONLY their OWN settings fields.
        // Profile photos must come from NeoTask's configured Cloudinary
        // account; role/accountStatus/email remain protected.
        (isOwner(uid) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['soundMessagesEnabled', 'soundTasksEnabled', 'remindersEnabled', 'profilePhotoUrl', 'managerWelcomeVersion']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['managerWelcomeVersion']) ||
          (resource.data.role == 'manager' &&
           request.resource.data.managerWelcomeVersion is int &&
           request.resource.data.managerWelcomeVersion == 1)) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profilePhotoUrl']) ||
          (request.resource.data.profilePhotoUrl is string &&
           request.resource.data.profilePhotoUrl.matches('https://res[.]cloudinary[.]com/unofnu8o/.*'))));

      allow delete: if false; // soft-delete only, via accountStatus field
    }

    // ---- tasks ----
    match /tasks/{taskId} {
      allow read: if isSignedIn();

      allow create: if isManager() &&
        request.resource.data.assignedBy == request.auth.uid;

      // Manager: unrestricted update (review decisions, edits, reassignment
      // approve/reject, priority/dueDate changes, etc.) — this is the ONLY
      // branch that may ever touch `priority` or `dueDate` (see Part 4:
      // these two fields are manager-only at ALL times, regardless of the
      // task's status — enforced here structurally, since NONE of the
      // three employee branches below list `priority`/`dueDate` in their
      // `hasOnly()` allowlists, so an employee write touching either field
      // is rejected outright by `hasOnly()` failing, independent of
      // `status`).
      //
      // Employee — THREE distinct self-service branches (none may change
      // `assignedBy`, `priority`, or `dueDate`, and none of the
      // manager-only review-decision fields reviewedBy/reviewDecision/
      // reviewNote/revisionCount may be touched):
      //
      //   (a) Normal lifecycle — the assignee updates their own task's
      //       status/submission fields, OR appends an `activityLog` entry
      //       (Part 2 — allowed unconditionally, i.e. regardless of
      //       `status`, including after submission/approval/rejection;
      //       NOT gated behind a status check in this branch). `assignedTo`
      //       unchanged.
      //   (b) Reassignment REQUEST (NEW feature) — the CURRENT assignee
      //       proposes handing the task to someone else. `assignedTo` is
      //       NOT changed by this branch (per answer ٦: only the new
      //       employee's own confirmation, branch (c), may change it) —
      //       only the 4 reassignRequest* fields + updatedAt are written,
      //       and reassignRequestedStatus must be exactly 'pending'.
      //   (c) Reassignment CONFIRMATION (NEW feature) — the PROPOSED new
      //       employee accepts a manager-approved request. This is the
      //       ONLY employee-write branch allowed to change `assignedTo`,
      //       and only to their OWN uid, and only when the task was
      //       already sitting in 'awaitingNewEmployee' addressed to them.
      allow update: if isManager() ||
        (isSignedIn() &&
         resource.data.assignedTo == request.auth.uid &&
         request.resource.data.assignedTo == resource.data.assignedTo &&
         request.resource.data.assignedBy == resource.data.assignedBy &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'submittedAt', 'submissionNote', 'updatedAt', 'viewedByEmployee', 'activityLog', 'progressPercent']) &&
         (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'assigned' && request.resource.data.status == 'inProgress') ||
          (resource.data.status == 'inProgress' && request.resource.data.status == 'submitted') ||
          ((resource.data.status == 'rejected' || resource.data.status == 'editRequested') &&
           request.resource.data.status == 'inProgress')) &&
         (!(resource.data.status == 'inProgress' &&
            request.resource.data.status == 'submitted') ||
          request.resource.data.progressPercent == 100) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progressPercent']) ||
          (request.resource.data.progressPercent is int &&
           request.resource.data.progressPercent >= 0 &&
           request.resource.data.progressPercent <= 100 &&
           (resource.data.status == 'assigned' || resource.data.status == 'inProgress') &&
           (request.resource.data.progressPercent == 0 ||
            request.resource.data.status == 'inProgress' ||
            request.resource.data.status == 'submitted')))) ||
        (isSignedIn() &&
         resource.data.assignedTo == request.auth.uid &&
         request.resource.data.assignedTo == resource.data.assignedTo &&
         request.resource.data.assignedBy == resource.data.assignedBy &&
         request.resource.data.reassignRequestedStatus == 'pending' &&
         request.resource.data.reassignRequestedBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reassignRequestedTo', 'reassignRequestedBy', 'reassignRequestedAt', 'reassignRequestedStatus', 'updatedAt'])) ||
        (isSignedIn() &&
         resource.data.reassignRequestedStatus == 'awaitingNewEmployee' &&
         resource.data.reassignRequestedTo == request.auth.uid &&
         request.resource.data.assignedTo == request.auth.uid &&
         request.resource.data.assignedBy == resource.data.assignedBy &&
         request.resource.data.reassignRequestedStatus == null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['assignedTo', 'reassignRequestedTo', 'reassignRequestedBy', 'reassignRequestedAt', 'reassignRequestedStatus', 'viewedByEmployee', 'updatedAt'])) ||
        // Automatic reminders feature (التذكيرات التلقائية) — NEW. Same
        // trust model as the polls/{pollId} auto-close branch above (no
        // Cloud Functions/cron exists in this project — see
        // TaskProvider._maybeDispatchReminders doc comment): ANY
        // signed-in client's lazy per-session check may be the one that
        // observes a task has crossed the 24h-before-due or the overdue
        // threshold and performs the one-way idempotency-flag write.
        // Each branch is restricted to a single null -> non-null
        // transition on exactly one guard field, so no client can ever
        // reset a flag back to null or piggyback an unrelated field
        // change onto this branch.
        (isSignedIn() &&
         resource.data.remindedAt == null &&
         request.resource.data.remindedAt != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['remindedAt', 'updatedAt'])) ||
        (isSignedIn() &&
         resource.data.overdueNotifiedAt == null &&
         request.resource.data.overdueNotifiedAt != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['overdueNotifiedAt', 'updatedAt']));

      allow delete: if isManager();
    }

    // ---- task_history (append-only audit log) ----
    match /task_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- invitations ----
    // Read stays PUBLIC and unauthenticated on purpose: an employee
    // clicking a manager-shared invite link has, by definition, no account
    // yet, so RegisterViaInviteScreen must be able to validate the token
    // before any sign-in occurs.
    //
    // RESIDUAL LIMITATION (flagged): this means any visitor can list ALL
    // invitation documents (including already-used ones), not just the one
    // token they were given — i.e. token enumeration is possible. This is a
    // real, acknowledged trade-off, not eliminated by this pass. A future
    // hardening step would move invite validation behind a Cloud Functions
    // callable (server-side single-token lookup) instead of a public
    // collection read.
    match /invitations/{inviteId} {
      allow read: if true;

      allow create: if isManager() &&
        request.resource.data.createdBy == request.auth.uid;

      // Consuming an invite: the new employee is ALREADY signed in by the
      // time this write happens (createUserWithEmailAndPassword runs before
      // the transaction — see AuthProvider.registerViaInvite), so this can
      // safely require auth. Only a pending -> used transition, only by the
      // uid that is registering, only touching the three burn-related
      // fields.
      allow update: if isSignedIn() && !isDesigner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'usedAt', 'usedByUid']);

      allow delete: if false;
    }

    // ---- messages (general DM + per-task chat threads) ----
    match /messages/{messageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.senderUid == request.auth.uid;

      // Only the recipient can mark a message read, and only the `readAt`
      // field — matches markConversationRead's exact semantics. A designer
      // is never a real recipient (see ChatThreadBody's `readOnly` flag,
      // which already skips calling markConversationRead client-side), but
      // this rule denies it independently at the server layer too (3-no).
      allow update: if isSignedIn() && !isDesigner() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      allow delete: if false;
    }

    // ---- calendar_imports / calendar_settings ----
    // Per-user data, but read via the same unfiltered-listen pattern as
    // above — gated on sign-in only. No PII beyond imported event
    // titles/times and an ICS feed URL the user supplied themselves.
    match /calendar_imports/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isDesigner();
    }

    match /calendar_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isDesigner();
    }

    // ---- managed knowledge centre (pages/files + workflow + audit trail) ----
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.documentId == docId &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.version == 1;
      // The owner authors revisions; the manager owns approval/archive.
      allow update: if isSignedIn() && !isDesigner() &&
        (isManager() ||
         ((resource.data.uploadedBy == request.auth.uid ||
           resource.data.ownerUid == request.auth.uid) &&
          request.resource.data.documentId == resource.data.documentId &&
          request.resource.data.uploadedBy == resource.data.uploadedBy &&
          request.resource.data.uploadedByName == resource.data.uploadedByName &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.ownerName == resource.data.ownerName &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.status in ['draft', 'inReview'] &&
          request.resource.data.version is int &&
          request.resource.data.version >= resource.data.version &&
          request.resource.data.version <= resource.data.version + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'fileUrl', 'fileName', 'fileType', 'category',
            'description', 'content', 'kind', 'department', 'tags',
            'reviewerUid', 'reviewerName', 'status', 'version', 'updatedAt',
            'updatedBy', 'updatedByName', 'reviewDueDate', 'approvedAt',
            'approvedBy', 'approvedByName', 'reviewReminderSentAt',
            'reviewReminderForDate', 'linkedTaskIds'
          ])));
      allow delete: if isSignedIn() && !isDesigner() &&
        (isManager() || resource.data.uploadedBy == request.auth.uid ||
         resource.data.ownerUid == request.auth.uid);

      match /versions/{revisionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && !isDesigner() &&
          request.resource.data.documentId == docId &&
          request.resource.data.changedByUid == request.auth.uid &&
          request.resource.data.version ==
            getAfter(/databases/$(database)/documents/documents/$(docId)).data.version &&
          (isManager() ||
           getAfter(/databases/$(database)/documents/documents/$(docId)).data.ownerUid == request.auth.uid ||
           getAfter(/databases/$(database)/documents/documents/$(docId)).data.uploadedBy == request.auth.uid);
        allow update: if false;
        allow delete: if isSignedIn() && !isDesigner() &&
          (isManager() ||
           get(/databases/$(database)/documents/documents/$(docId)).data.ownerUid == request.auth.uid ||
           get(/databases/$(database)/documents/documents/$(docId)).data.uploadedBy == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && !isDesigner() &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && !isDesigner() &&
          (resource.data.authorUid == request.auth.uid || isManager() ||
           get(/databases/$(database)/documents/documents/$(docId)).data.ownerUid == request.auth.uid ||
           get(/databases/$(database)/documents/documents/$(docId)).data.uploadedBy == request.auth.uid);
      }
    }

    // ---- meetings (schedule only, no live call integration) ----
    match /meetings/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.meetingId == docId &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && !isDesigner() &&
        (isManager() ||
         (resource.data.createdBy == request.auth.uid &&
          request.resource.data.meetingId == resource.data.meetingId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdByName == resource.data.createdByName &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'startTime', 'endTime', 'location',
            'participantUids', 'agendaItems', 'minutes', 'decisions',
            'status', 'updatedAt'
          ])));
      allow delete: if isSignedIn() && !isDesigner() &&
        (resource.data.createdBy == request.auth.uid || isManager());
    }

    // ---- contacts ----
    match /contacts/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && !isDesigner() &&
        (resource.data.createdBy == request.auth.uid || isManager());
    }

    // ---- favorites (per-user starred tasks; docId is deterministic
    //      "{userUid}_{taskId}" — see FirestoreService.favoriteIdFor) ----
    match /favorites/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDesigner() &&
        request.resource.data.userUid == request.auth.uid;
      allow delete: if isSignedIn() && !isDesigner() &&
        resource.data.userUid == request.auth.uid;
      allow update: if false;
    }

    // ---- goals / criteria / chat (REBUILT genuine nested subcollection
    //      hierarchy, see goal_model.dart / criterion_model.dart /
    //      criterion_chat_model.dart):
    //        goals/{goalId}
    //          -> title, description, createdBy, startDate, endDate
    //        goals/{goalId}/criteria/{criteriaId}
    //          -> title, description, status, assignees: [uid, ...]
    //        goals/{goalId}/criteria/{criteriaId}/chat/{messageId}
    //          -> senderId, text, timestamp
    //      REBUILD NOTE: no `isClosed`/`closedAt` on Goal and no manager
    //      approve/reject review gate or history log on Criterion
    //      anymore — both were removed per the simplified spec. Any
    //      assignee OR the manager may freely update `status`.
    // ---- criteria collection-group read authorization ----
    // CRITICAL: FirestoreService listens via `collectionGroup('criteria')`
    // (a single cross-goal query spanning every goals/{goalId}/criteria
    // subcollection at once — see firestore_service.dart _listenAuth()).
    // Per Firebase's OWN documentation ("Structuring Cloud Firestore
    // Security Rules", https://firebase.google.com/docs/firestore/security/rules-structure):
    // "To authorize collection group queries, a top-level recursive
    // wildcard match block is required. Standard nested match statements
    // apply rules only to specific paths relative to their parents and do
    // NOT automatically cover collection group queries." — i.e. the nested
    // `allow read` inside `match /goals/{goalId} { match /criteria/{..} }`
    // below is NOT sufficient on its own to authorize this query; it only
    // authorizes a direct/scoped read like `goals/{knownGoalId}/criteria`.
    // This top-level block is what actually grants the collectionGroup
    // read. Empirically verified: the collectionGroup('criteria') read was
    // rejected with HTTP 403 PERMISSION_DENIED for a real authenticated
    // manager BEFORE this block was added (see test_read_criteria.py).
    // Writes are unaffected/unchanged — they are always single-document
    // ops via a known goalId, never collection-group queries, so the
    // nested match's create/update/delete rules below remain sufficient.
    match /{path=**}/criteria/{criterionId} {
      allow read: if isSignedIn();
    }

    match /goals/{goalId} {
      allow read: if isSignedIn();
      allow create: if isManager() &&
        request.resource.data.createdBy == request.auth.uid;

      // Manager: unrestricted update (title/description/dates/color/icon,
      // and may also append comments). Employee: may update ONLY the
      // `comments` field (goal-level "تعليقات سريعة" — see
      // GoalProvider.addComment / GoalComment doc comment) — cannot alter
      // title/description/dates/color/icon. Goal reads are already
      // unrestricted for every signed-in user (see `allow read` above),
      // so allowing any signed-in user to append a comment matches that
      // same existing breadth rather than introducing a NEW residual
      // permissiveness gap (consistent with the already-flagged
      // tasks/polls "unfiltered listen + client-side filter" limitation
      // documented elsewhere in this file).
      allow update: if isManager() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['comments', 'updatedAt']));

      allow delete: if isManager();

      match /criteria/{criterionId} {
        allow read: if isSignedIn();

        allow create: if isManager() &&
          request.resource.data.assignedBy == request.auth.uid;

        // Manager: unrestricted update (title/description/assignees, via
        // CriterionProvider.updateCriterion/setAssignees). Employee: may
        // update ONLY a criterion they are a member of (list-membership
        // via `hasAny`, not `==` equality), and ONLY their OWN entry
        // inside the `employeeStatuses` map (see
        // CriterionProvider.setEmployeeStatus /
        // FirestoreService.updateCriterionEmployeeStatus's dotted-field
        // write) — cannot alter assignment/title/description, and cannot
        // touch a colleague's status entry. The second-to-last line
        // below diffs the `employeeStatuses` MAP ITSELF (not just the
        // top-level document) to confirm the ONLY map key that changed
        // is the writer's own uid.
        allow update: if isManager() ||
          (isSignedIn() &&
           resource.data.assignees.hasAny([request.auth.uid]) &&
           request.resource.data.assignees == resource.data.assignees &&
           request.resource.data.assignedBy == resource.data.assignedBy &&
           request.resource.data.title == resource.data.title &&
           request.resource.data.description == resource.data.description &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['employeeStatuses', 'updatedAt']) &&
           request.resource.data.employeeStatuses
             .diff(resource.data.employeeStatuses)
             .affectedKeys().hasOnly([request.auth.uid]));

        allow delete: if isManager();

        match /chat/{messageId} {
          // Any signed-in user who is either the manager or a listed
          // assignee on the parent criterion may read/write the chat.
          // Messages are append-only (no edit/delete of prior messages).
          allow read: if isSignedIn() &&
            (isManager() ||
             get(/databases/$(database)/documents/goals/$(goalId)/criteria/$(criterionId))
               .data.assignees.hasAny([request.auth.uid]));
          allow create: if isSignedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            (isManager() ||
             get(/databases/$(database)/documents/goals/$(goalId)/criteria/$(criterionId))
               .data.assignees.hasAny([request.auth.uid]));
          allow update, delete: if false;
        }
      }
    }

    // ---- polls ("تصويت") — MULTI-STATUS/MULTI-CHOICE LIFECYCLE UPGRADE.
    //      See poll_model.dart / poll_vote_model.dart / poll_report_model.dart
    //      for the full architecture note, including the empirically
    //      VERIFIED finding (service-account IAM probe, not an assumption)
    //      that genuine Cloud Functions/Cloud Scheduler are UNAVAILABLE in
    //      this project (no billing/API-enablement permission, no
    //      interactive `firebase login` possible from this sandbox) — the
    //      server-time guarantees below are the closest achievable
    //      substitute using Firestore rules + transactions alone. ----
    match /polls/{pollId} {
      // Same unfiltered-listen + client-side-filter architecture as
      // tasks/messages above (see class-level doc comment): the poll
      // DOCUMENT ITSELF (title/description/dates/status/aggregate counts)
      // carries no secret content — only the per-employee VOTE (below) is
      // secrecy-sensitive. RESIDUAL LIMITATION (flagged, consistent with
      // the existing tasks/messages limitation documented above): any
      // signed-in employee can technically read a poll document they were
      // NOT selected for, since `getPollsForEmployee` filters client-side
      // over an unfiltered listener. This does not leak anyone's vote.
      allow read: if isSignedIn();

      // Manager-only creation. `deadline`/`startDateTime` MUST be genuine
      // Firestore Timestamps (not strings) — this is what makes the
      // server-time vote cutoff below possible; a poll created with a
      // string date would silently defeat that enforcement, so it is
      // rejected outright here rather than allowed through.
      allow create: if isManager() &&
        request.resource.data.createdBy == request.auth.uid &&
        (request.resource.data.status == 'draft' ||
         request.resource.data.status == 'active') &&
        request.resource.data.reportGenerated == false &&
        request.resource.data.deadline is timestamp &&
        request.resource.data.startDateTime is timestamp;

      // Six disjoint update paths — role-based per requirement §8:
      //
      //   (a) MANAGER EDIT (draft or active, status unchanged) — title,
      //       description, choices, eligible employees, start/end
      //       date-time, privacy toggle. Destructive-change confirmation
      //       (e.g. "reset votes if choices changed") is a CLIENT-SIDE UX
      //       gate (see PollProvider.updatePoll's resetVotes param); the
      //       rule only enforces WHO may write and WHICH fields, matching
      //       this file's existing trust model for client-computed
      //       decisions elsewhere (tasks, goals).
      //   (b) MANAGER PUBLISH — draft -> active, optionally combined with
      //       an edit in the same write.
      //   (c) MANAGER CANCEL — draft or active -> cancelled. Existing
      //       votes are NEVER touched by this branch (no vote-deletion
      //       field exists on the poll document itself).
      //   (d) AUTO-END, SERVER-TIME ENFORCED — any signed-in client may
      //       perform the active -> ended transition, but ONLY once
      //       `request.time >= resource.data.deadline` is ALREADY true
      //       (a genuine Firestore server-side timestamp comparison, not
      //       a client-supplied value) — this is the concrete upgrade
      //       over the previous string-deadline design, which could not
      //       express this check at all. `reportGenerated` must flip
      //       false -> true in the SAME write, one-way only (enforced
      //       below), which is what makes PollProvider's ending
      //       transaction exactly-once even under a multi-client race.
      //   (e) MANAGER TIE DECISION — only the poll's own manager, only on
      //       an ALREADY-ended poll, only touching the winner/decision
      //       fields (status remains `ended` throughout, permanent-
      //       archive requirement).
      //   (f) MANAGER REMINDER cooldown write — "حث الموظفين على
      //       التصويت" persists only `lastReminderSentAt`; the actual
      //       reminder notifications are separate `notifications` writes.
      //   (g) MANAGER ADMIN NOTES post-ended — the ONLY field editable
      //       after `ended`, per the explicit "no editing after Ended
      //       except non-result-affecting admin notes" requirement.
      allow update: if
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         (resource.data.status == 'draft' || resource.data.status == 'active') &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['title', 'description', 'choices', 'participantUids',
                     'startDateTime', 'deadline', 'privacyEnabled'])) ||
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         resource.data.status == 'draft' &&
         request.resource.data.status == 'active' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'title', 'description', 'choices',
                     'participantUids', 'startDateTime', 'deadline',
                     'privacyEnabled'])) ||
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         (resource.data.status == 'draft' || resource.data.status == 'active') &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'cancelledBy', 'cancelledAt'])) ||
        (isSignedIn() &&
         resource.data.status == 'active' &&
         request.resource.data.status == 'ended' &&
         request.time >= resource.data.deadline &&
         resource.data.reportGenerated == false &&
         request.resource.data.reportGenerated == true &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'reportGenerated', 'endedAt', 'choiceCounts',
                     'winningChoiceIndex', 'isTie', 'tiedChoiceIndexes'])) ||
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         resource.data.status == 'ended' &&
         request.resource.data.status == 'ended' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['winningChoiceIndex', 'isTie', 'managerDecisionBy', 'managerDecisionAt'])) ||
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastReminderSentAt'])) ||
        (isManager() &&
         resource.data.createdBy == request.auth.uid &&
         resource.data.status == 'ended' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['adminNotes']));

      allow delete: if isManager() && resource.data.createdBy == request.auth.uid;

      // ---- votes (genuine SUBCOLLECTION, doc ID == employeeUid — see
      //      poll_vote_model.dart doc comment on why this is NOT an
      //      embedded map: field-level secrecy is impossible under
      //      Firestore's document-level rules, so each vote is its own
      //      document with its own read rule) ----
      match /votes/{employeeUid} {
        // The core secrecy enforcement: an employee may read ONLY their
        // own vote document; the poll's manager may read every vote (used
        // by the manager's live per-employee status view, requirement
        // #2, and the permanent report, requirement #6).
        allow read: if isSignedIn() &&
          (isDesigner() ||
           employeeUid == request.auth.uid ||
           (isManager() &&
            get(/databases/$(database)/documents/polls/$(pollId)).data.createdBy == request.auth.uid));

        // Cast or CHANGE a vote — only the voting employee themselves,
        // only while the poll is genuinely `active` AND its `deadline`
        // (a real Firestore Timestamp, see the `create` rule above) has
        // NOT yet passed per Firestore's OWN server clock
        // (`request.time`) — this is the concrete server-time upgrade:
        // unlike the previous string-deadline design, a vote is rejected
        // the INSTANT the deadline passes, independent of whether any
        // client has yet performed the active -> ended transition above.
        // Only "eligible employees" (the poll's participantUids) may
        // vote — enforces the role-based permission requirement (§8:
        // "employees may vote only while active").
        allow create, update: if isSignedIn() &&
          employeeUid == request.auth.uid &&
          request.resource.data.employeeUid == request.auth.uid &&
          get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'active' &&
          request.time < get(/databases/$(database)/documents/polls/$(pollId)).data.deadline &&
          get(/databases/$(database)/documents/polls/$(pollId)).data.participantUids.hasAny([request.auth.uid]);

        allow delete: if isManager() &&
          get(/databases/$(database)/documents/polls/$(pollId)).data.createdBy == request.auth.uid;
      }
    }

    // ---- poll_reports (PERMANENT final report — see poll_report_model.dart)
    //      Separate top-level collection, doc ID == pollId. Created ONLY
    //      via the SAME transaction that flips polls/{pollId}.reportGenerated
    //      false -> true (see FirestoreService.endPollAndGenerateReport),
    //      which is what makes this immutable-after-creation rule safe:
    //      there is no legitimate path to create this document a second
    //      time for the same pollId (the paired poll-side flag blocks the
    //      transaction itself from re-running), and no path at all to
    //      edit/delete it afterward, satisfying the "permanent record"
    //      requirement structurally, not just by convention. ----
    match /poll_reports/{pollId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.pollId == pollId &&
        !exists(/databases/$(database)/documents/poll_reports/$(pollId));

      // The ONLY legitimate post-creation change: the manager's tie-break
      // decision (winningChoiceIndex/isTie), mirroring the poll document's
      // own tie-decision branch above — everything else on a report is
      // permanently frozen at generation time.
      allow update: if isManager() &&
        get(/databases/$(database)/documents/polls/$(pollId)).data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['winningChoiceIndex', 'isTie']);

      allow delete: if false;
    }

    // ---- notifications (NEW system — see notification_model.dart doc
    //      comment for why this did not exist prior to the Poll feature)
    match /notifications/{notificationId} {
      // Same unfiltered-listen + client-side-filter pattern as
      // tasks/messages/polls above. RESIDUAL LIMITATION (flagged,
      // consistent with the rest of this file): any signed-in user can
      // technically read another user's notification documents, since a
      // per-document `recipientUid == request.auth.uid` read filter would
      // break the unfiltered `.snapshots()` listener this app's
      // architecture relies on everywhere (see class-level doc comment,
      // "queries are all-or-nothing"). No collection in this app achieves
      // true per-user read isolation under this architecture; this is not
      // a newly-introduced weakness, it matches the existing baseline.
      allow read: if isSignedIn();

      // Any signed-in client may create a notification for ANY
      // recipientUid — REQUIRED by this feature's own architecture: the
      // client that happens to trigger a poll's auto-close (which may be
      // an EMPLOYEE's device, not the manager's) is the one that must
      // write both the manager's and every participant's notification
      // documents at that moment (no backend/Cloud Function exists to do
      // this centrally — see poll_model.dart doc comment). This is a
      // genuine, deliberate trust concession specific to this
      // no-backend architecture, not an oversight.
      allow create: if isSignedIn() && !isDesigner();

      // Only the recipient may mark their own notification read.
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      allow delete: if false;
    }

    // ---- manager-configurable workflow automations ----
    // Rule definitions are manager-owned configuration. Execution logs are
    // server-authored by Cloud Functions and immutable from every client.
    match /automation_rules/{ruleId} {
      allow read: if isManager() || isDesigner();
      allow create, update: if isManager() &&
        request.resource.data.ruleId == ruleId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.trigger in ['taskCreated', 'statusChanged', 'dueSoon', 'overdue'] &&
        request.resource.data.conditionField in ['any', 'status', 'priority', 'category', 'assignee', 'progress'] &&
        request.resource.data.conditionOperator in ['equals', 'contains', 'greaterOrEqual'] &&
        request.resource.data.action in ['notifyAssignee', 'notifyManager', 'setPriority', 'reassign'] &&
        request.resource.data.dueWithinHours is int &&
        request.resource.data.dueWithinHours >= 1 &&
        request.resource.data.dueWithinHours <= 168;
      allow delete: if isManager() && resource.data.createdBy == request.auth.uid;
    }

    match /automation_runs/{runId} {
      allow read: if isManager() || isDesigner();
      allow write: if false;
    }

    // ---- custom forms and public response intake ----
    // Anonymous visitors may get one active form by its unguessable UUID and
    // submit a bounded answer map. Listing all forms remains manager-only.
    match /custom_forms/{formId} {
      allow get: if (resource.data.isActive == true) || isManager() || isDesigner();
      allow list: if isManager() || isDesigner();
      allow create, update: if isManager() &&
        request.resource.data.formId == formId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 2 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1500 &&
        request.resource.data.fields is list &&
        request.resource.data.fields.size() >= 1 &&
        request.resource.data.fields.size() <= 50;
      allow delete: if false;

      match /responses/{responseId} {
        allow read: if isManager() || isDesigner();
        allow create: if
          get(/databases/$(database)/documents/custom_forms/$(formId)).data.isActive == true &&
          request.resource.data.keys().hasOnly([
            'responseId', 'formId', 'answers', 'submittedAt', 'source'
          ]) &&
          request.resource.data.responseId == responseId &&
          request.resource.data.formId == formId &&
          request.resource.data.answers is map &&
          request.resource.data.answers.size() <= 50 &&
          request.resource.data.submittedAt is string &&
          request.resource.data.source == 'publicLink';
        allow update, delete: if false;
      }
    }

    // Manager-authored task and employee imports write one immutable summary.
    match /import_jobs/{jobId} {
      allow read: if isManager() || isDesigner();
      allow create: if isManager() &&
        request.resource.data.jobId == jobId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['tasks', 'employees'] &&
        request.resource.data.rowCount is int &&
        request.resource.data.rowCount > 0 &&
        request.resource.data.rowCount <= 5000;
      allow update, delete: if false;
    }

    // ---- manager_ideas ----
    // A private idea inbox shared only by the manager and NeoTask's
    // read-only observer. Employees cannot read it. The observer remains
    // strictly read-only; only the manager may create or remove their own
    // idea documents.
    match /manager_ideas/{ideaId} {
      allow read: if isManager() || isDesigner();

      allow create: if isManager() &&
        request.resource.data.keys().hasOnly([
          'ideaId',
          'content',
          'authorUid',
          'authorName',
          'createdAt',
          'status'
        ]) &&
        request.resource.data.ideaId == ideaId &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 3 &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() >= 1 &&
        request.resource.data.authorName.size() <= 120 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.status == 'new';

      allow update: if false;

      allow delete: if isManager() &&
        resource.data.authorUid == request.auth.uid;
    }

    // ---- password_change_audit (Part 1 — manager-driven password reset
    //      audit trail) ----
    // Append-only log of WHO changed a password, FOR WHOM, and WHEN. The
    // actual password value is NEVER written here (see
    // manager_employees_tab.dart's _startChangePasswordFlow) — only uids,
    // display names, and a timestamp. Only a manager may write an entry
    // (mirrors the fact that only the adminResetPassword Cloud Function's
    // caller-side UI writes this), and only managers may read the log
    // back (this is an internal admin audit trail, not a user-facing
    // notification).
    match /password_change_audit/{entryId} {
      allow read: if isManager();
      allow create: if isManager() &&
        request.resource.data.changedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- manager_digests ("ملخص المدير اليومي/الأسبوعي") — NEW.
    //      See manager_digest_model.dart doc comment: one immutable
    //      document per manager per calendar day, doc ID ==
    //      "{managerUid}_{dateKey}", generated CLIENT-SIDE (no Cloud
    //      Scheduler — Blaze plan unavailable, same documented constraint
    //      as polls'/tasks' auto-close/reminder features) by
    //      DigestProvider.maybeGenerateTodayDigest the first time the
    //      manager's dashboard opens on a given day.
    //      VISIBILITY: manager role ONLY, and only their OWN digests —
    //      never shared across managers, never readable by
    //      employee/designer roles.
    match /manager_digests/{digestId} {
      // BUGFIX (found by empirical rules test, 2026-07-18): the original
      // condition `resource.data.managerUid == request.auth.uid` fails
      // with PERMISSION_DENIED for a NON-EXISTENT document (`resource` is
      // null when the doc doesn't exist yet), which is exactly the case
      // on the FIRST read of the day (DigestProvider.getDigest's
      // existence check, called before any digest has ever been
      // generated). Since `digestId` is itself the deterministic
      // "{managerUid}_{dateKey}" string, checking that the requested ID
      // is prefixed with the caller's own uid is sufficient to enforce
      // per-manager ownership WITHOUT depending on `resource` existing.
      allow read: if isManager() &&
        digestId.matches(request.auth.uid + '_.*');

      // Created exactly once per day by the digest's own manager — the
      // deterministic doc ID (managerUid_dateKey) combined with
      // DigestProvider's own "does it already exist?" pre-check is what
      // prevents duplicate generation attempts; this rule only enforces
      // WHO may create and that the document is self-attributed.
      allow create: if isManager() &&
        request.resource.data.managerUid == request.auth.uid &&
        request.resource.data.id == digestId;

      // Immutable after creation — no legitimate reason to ever edit a
      // past digest (it is a point-in-time snapshot, not a live view).
      allow update, delete: if false;
    }
  }
}
