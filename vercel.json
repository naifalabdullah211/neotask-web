{
  "version": 2,
  "functions": {
    "api/agent.js": {
      "maxDuration": 30
    },
    "api/multi-agent.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
